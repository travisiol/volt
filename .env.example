# ---------------------------------------------------------------------------
# VOLT — configuration. Copy to .env.local. Everything NEXT_PUBLIC_* ships to
# the browser; keep keys out of it.
# ---------------------------------------------------------------------------


# Robinhood Chain (defaults shown).
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RPC_FALLBACKS=https://robinhood-rpc.publicnode.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# CONFIGURE — the VOLT ERC-20 (a Pons V2 launch) and the reserve wallet that
# receives routed fees and holds the TSLA Stock Tokens.
NEXT_PUBLIC_VOLT_TOKEN=
NEXT_PUBLIC_RESERVE_WALLET=
# First block to scan for TSLA inflows to the reserve (set it: scanning from 0 is slow).
NEXT_PUBLIC_RESERVE_START_BLOCK=0

# Optional, shown in VERIFY EVERYTHING when set.
NEXT_PUBLIC_EXECUTOR=
NEXT_PUBLIC_ROUTING_CONTRACT=

# VERIFIED — Tesla • Robinhood Token (TSLA), 18 decimals. Override only if it moves.
NEXT_PUBLIC_TSLA_TOKEN=0x322f0929c4625ed5bad873c95208d54e1c003b2d

# The charge, in USD, at which a purchase becomes eligible.
NEXT_PUBLIC_TARGET_CHARGE_USD=1000

# Where TRADE VOLT goes. Defaults to the Pons page of the token.
NEXT_PUBLIC_TRADE_URL=

# Holder rewards: off unless both are set AND the contract answers claimable/totalDistributed/nextDistributionAt.
NEXT_PUBLIC_HOLDER_REWARDS=false
NEXT_PUBLIC_REWARDS_CONTRACT=

# WalletConnect Cloud project id (mobile wallets). Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://volt.example
NEXT_PUBLIC_TWITTER_URL=

# Server only — Pyth Hermes (best price source). Without it the server falls
# back to Yahoo Finance (delayed) and then to Pyth on-chain (can be stale).
PYTH_API_KEY=
PYTH_HERMES_URL=https://hermes.pyth.network
